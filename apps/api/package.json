{
  "name": "khakadx-api",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run generate && npm run compile",
    "compile": "npx tsc",
    "test": "jest --runInBand",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
